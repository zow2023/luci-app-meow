{
	"luci-app-meow": {
		"description": "Grant access to meow service configuration",
		"read": {
			"uci": [ "meow" ],
			"ubus": {
				"service": [ "list" ],
				"log": [ "read" ],
				"file": {
					"read": [ "/etc/meow/*" ]
				}
			}
		},
		"write": {
			"uci": [ "meow" ],
			"ubus": {
				"file": {
					"write": [ "/etc/meow/*" ],
					"exec": [ "/bin/chmod", "/etc/init.d/meow" ]
				}
			}
		}
	}
}
