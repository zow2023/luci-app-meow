#!/bin/sh /etc/rc.common

USE_PROCD=1

START=99
STOP=15

PROG=/usr/bin/meow
CONF=/etc/meow/config.yaml

NFT_TEMPLATE=/etc/meow/gateway.nft.template
NFT_RULES=/etc/meow/gateway.nft

extra_command "render_nft" "Render nft rules"

boot() {
	START=99
	start "$@"
}

config_gateway_enabled() {
	config_load meow

	config_get_bool enabled main enabled 0
	config_get_bool gateway main gateway 0

	[ "$enabled" = "1" ] && [ "$gateway" = "1" ]
}

render_nft() {
	local lan_if lan_ip tport dnsport

	config_load meow

	config_get_bool gateway main gateway 0
	config_get tport main tproxy_port 7893
	config_get dnsport main dns_port 1053

	[ "$gateway" = "1" ] || return 1

	lan_if="$(uci -q get network.lan.device)"
	[ -n "$lan_if" ] || lan_if="br-lan"

	lan_ip="$(uci -q get network.lan.ipaddr)"
	lan_ip="${lan_ip%%/*}"

	[ -n "$lan_ip" ] || return 1

	sed \
		-e "s|@LAN_IF@|$lan_if|g" \
		-e "s|@LAN_IP@|$lan_ip|g" \
		-e "s|@TPORT@|$tport|g" \
		-e "s|@DNSPORT@|$dnsport|g" \
		"$NFT_TEMPLATE" \
		> "$NFT_RULES"

	logger -t meow "nft generated"
}

wait_tproxy() {
	local port="$1"
	local i=0

	# 以 procd 中的实例状态为准：netstat 在部分固件上不存在，
	# 且 busybox 输出格式不统一，端口嗅探很容易误判。
	while [ $i -lt 30 ]; do
		ubus call service list '{"name":"meow"}' 2>/dev/null |
			grep -q '"running": *true' && return 0

		sleep 1
		i=$((i+1))
	done

	return 1
}

apply_gateway_rules() {
	config_load meow

	config_get_bool enabled main enabled 0
	config_get_bool gateway main gateway 0

	# 未启用或未开网关模式：绝不允许留下规则
	if [ "$enabled" != "1" ] || [ "$gateway" != "1" ]; then
		remove_gateway_rules
		return 0
	fi

	config_get tport main tproxy_port 7893

	render_nft || return 1

	# 接收流量的进程没就绪时坚决不上规则，否则 LAN 流量会被黑洞
	if ! wait_tproxy "$tport"; then
		logger -t meow "tproxy not ready on port $tport; nft rules NOT applied"
		remove_gateway_rules
		return 1
	fi

	nft -f "$NFT_RULES"
}

remove_gateway_rules() {
	nft delete table inet meow_gateway 2>/dev/null
}

service_triggers() {
	procd_add_reload_trigger meow
	procd_add_reload_trigger network
}

start_service() {
	local enabled config_file work_dir

	config_load meow

	config_get_bool enabled main enabled 0
	config_get config_file main config_file "$CONF"
	config_get work_dir main work_dir /etc/meow

	# 关闭服务的路径不会调用 service_stopped，
	# 这里必须先清掉残留规则
	if [ "$enabled" != "1" ]; then
		remove_gateway_rules
		logger -t meow "disabled"
		return 0
	fi

	if ! "$PROG" -f "$config_file" -t >/dev/null 2>&1; then
		logger -t meow "config test failed"
		return 1
	fi

	procd_open_instance

	procd_set_param command \
		"$PROG" \
		-f "$config_file" \
		-d "$work_dir"

	# OpenWrt 25.12 apk环境修正
	procd_set_param env HOME="$work_dir"

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1

	procd_set_param file \
		"$config_file" \
		"/etc/config/meow"

	procd_close_instance
}

stop_service() {
	remove_gateway_rules
}

# 显式提供 reload_service，避免 rc.common 把 reload 退化成 start
# 从而绕过 service_stopped 的规则清理。
reload_service() {
	stop "$@"
	start "$@"
}

service_started() {
	if ! config_gateway_enabled; then
		remove_gateway_rules
		return 0
	fi

	apply_gateway_rules
}

service_stopped() {
	remove_gateway_rules
}
