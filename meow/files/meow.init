#!/bin/sh /etc/rc.common

# meow init script (procd)
# - validates YAML via `meow -t` before start
# - loads the transparent-gateway nft table when gateway=1
# - re-applies the table on firewall reloads (fw4)

USE_PROCD=1
START=99
STOP=15

PROG=/usr/bin/meow
CONF=/etc/meow/config.yaml
NFT_TEMPLATE=/etc/meow/gateway.nft.template
NFT_RULES=/etc/meow/gateway.nft

BOOT=""

extra_command "status" "Show service status"
extra_command "render_nft" "Render and print the nft rules file (debug)"

boot() {
    BOOT=1
    start "$@"
}

render_nft() {
    local lan_if lan_ip tport dnsport

    config_load meow
    config_get_bool gateway main gateway 0
    config_get tport  main tproxy_port 7893
    config_get dnsport main dns_port 1053

    [ "$gateway" = "1" ] || return 1

    lan_if="$(uci -q get network.lan.device)"
    [ -n "$lan_if" ] || lan_if="br-lan"

    lan_ip="$(uci -q get network.lan.ipaddr)"
    [ -n "$lan_ip" ] || lan_ip="$(ifstatus lan 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address')"
    # DNAT target must be a bare IP: uci may store "10.0.0.1/24"
    lan_ip="${lan_ip%%/*}"

    [ -n "$lan_ip" ] || {
        logger -t meow "render_nft: cannot determine LAN IPv4 address"
        return 1
    }

    sed -e "s|@LAN_IF@|$lan_if|g" \
        -e "s|@LAN_IP@|$lan_ip|g" \
        -e "s|@TPORT@|$tport|g" \
        -e "s|@DNSPORT@|$dnsport|g" \
        "$NFT_TEMPLATE" > "$NFT_RULES"

    logger -t meow "render_nft: wrote $NFT_RULES (lan=$lan_if/$lan_ip tproxy=$tport dns=$dnsport)"
}

wait_tproxy() {
    local port="$1" i=0

    # meow binds the tproxy listener; wait up to 30s for it
    while [ $i -lt 30 ]; do
        netstat -lntp 2>/dev/null | grep -q ":$port " && return 0
        sleep 1
        i=$((i+1))
    done
    return 1
}

apply_gateway_rules() {
    local tport

    config_load meow
    config_get_bool gateway main gateway 0
    [ "$gateway" = "1" ] || return 0

    config_get tport main tproxy_port 7893

    render_nft || {
        logger -t meow "apply_gateway_rules: render_nft failed"
        return 1
    }

    wait_tproxy "$tport" || {
        logger -t meow "tproxy :$tport not listening after 30s; gateway rules NOT applied"
        return 1
    }

    nft -f "$NFT_RULES" || {
        logger -t meow "failed to load gateway nft rules"
        return 1
    }
    logger -t meow "gateway nft rules loaded"
}

remove_gateway_rules() {
    nft delete table inet meow_gateway 2>/dev/null
}

service_triggers() {
    procd_add_reload_trigger "meow"
    procd_add_reload_trigger "network"
}

start_service() {
    local enabled config_file work_dir panel_port

    config_load meow
    config_get_bool enabled main enabled 0
    config_get config_file main config_file "$CONF"
    config_get work_dir  main work_dir /etc/meow
    config_get panel_port main panel_port 9090

    [ "$enabled" = "1" ] || {
        logger -t meow "service disabled in UCI"
        return 0
    }

    # YAML sanity check: refuse to start a broken config
    "$PROG" -f "$config_file" -t 2>&1 | while read -r line; do
        logger -t meow "$line"
    done
    if ! "$PROG" -f "$config_file" -t >/dev/null 2>&1; then
        logger -t meow "config validation failed, refusing to start"
        return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" -f "$config_file" -d "$work_dir"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$config_file" "/etc/config/meow"
    procd_close_instance
}

service_started() {
    apply_gateway_rules
}

service_stopped() {
    remove_gateway_rules
}

reload_service() {
    stop
    start
}

status() {
    /etc/init.d/meow enabled && echo "enabled" || echo "disabled"
    ubus call service list "{ 'name': 'meow' }" | jsonfilter -e '@.meow.instances.meow.running'
}
